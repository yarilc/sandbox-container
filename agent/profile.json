{
  "schema": 1,
  "name": "sandbox-container",
  "display_name": "Sandbox",
  "wrapper": "sandbox-container.sh",
  "env_prefix": "SANDBOX_CONTAINER",
  "label_namespace": "io.sandbox-container",
  "identifiers": ["sandbox-container"],
  "images": {
    "agent": "localhost/sandbox-container",
    "proxy": "localhost/sandbox-container-egress",
    "toolchain": "localhost/sandbox-container-guard-toolchain"
  },
  "install": {
    "state_name": "sandbox-container-egress"
  },
  "native": {
    "home": "/sandbox-home",
    "command": "bash",
    "config_dir_env": "SANDBOX_CONTAINER_CONFIG_DIR",
    "config_home": ".config/sandbox-container",
    "shared_dirs": [".config/openspec"]
  },
  "auth": {}
}
